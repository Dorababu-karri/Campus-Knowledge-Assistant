# ==============================================================================
# Campus Knowledge Assistant - Web Application (TanStack Start + Node.js)
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app/web-app

# Install native build tools for better-sqlite3 & bcrypt
RUN apk add --no-cache python3 make g++

# Copy dependency manifests
COPY web-app/package.json ./

# Install npm dependencies
RUN npm install

# Copy web-app source files
COPY web-app/ ./

# Build production assets
RUN npm run build

# ==============================================================================
# Production Runtime
# ==============================================================================
FROM node:22-alpine AS runner

WORKDIR /app/web-app

RUN apk add --no-cache curl

ENV NODE_ENV=production \
    PORT=3000 \
    RAG_INTERNAL_SECRET=campus_rag_secret_2026

# Copy build artifacts and dependencies
COPY --from=builder /app/web-app/package.json ./
COPY --from=builder /app/web-app/node_modules ./node_modules
COPY --from=builder /app/web-app/dist ./dist
COPY --from=builder /app/web-app/src ./src
COPY --from=builder /app/web-app/data ./data
COPY --from=builder /app/web-app/vite.config.ts ./

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:3000/ || exit 1

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

